PORT=3001
CLIENT_URL=http://localhost:5173
DEMO_MODE=true
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
WEB_SEARCH_MODEL=gpt-5.6-luna
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Link the spreadsheet created from Google Form → Responses → Link to Sheets.
GREETINGS_SPREADSHEET_ID=
GREETINGS_SHEET_NAME=Form Responses 1
GREETINGS_NAME_HEADER=Name
GREETINGS_TIMESTAMP_HEADER=Timestamp
SHEETS_POLL_INTERVAL_MS=2000
ENABLE_WEB_SEARCH=true
ENABLE_AUTO_GREET=true

# Local Discord workshop (connect explicitly from /workshop)
ENABLE_DISCORD_QA=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_QUESTION_CHANNEL_ID=
DISCORD_MODERATION_CHANNEL_ID=
DISCORD_MODERATOR_ROLE_IDS=
PANDA_DATA_DIR=.local-data

# Optional: remove ordinary user messages from the question channel while online.
# Requires Manage Messages; keep Send Messages enabled for members to use slash commands.
DISCORD_COMMANDS_ONLY=false
