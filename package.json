{
  "name": "panda-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/src/index.ts\" \"vite --config client/vite.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "start": "node dist/server/src/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "format": "prettier --write .",
    "desktop": "npm run build && electron desktop/main.cjs",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "prettier": "^3.9.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "A presenter-controlled desktop mascot for moderated Discord Q&A and workshop sign-in greetings."
}
